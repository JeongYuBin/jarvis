{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "Personal AI Assistant",
  "main": "electron/main.js",
  "author": "Yubin",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && node server.js",
    "electron": "electron electron/main.js",
    "start": "concurrently \"npm run frontend\" \"npm run backend\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build:frontend && electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/server.js",
        "to": "backend/server.js"
      },
      {
        "from": "backend/database.js",
        "to": "backend/database.js"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS"
    }
  }
}
